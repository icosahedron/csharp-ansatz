<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Warrant\Warrant.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Frontend\Warrant.Frontend.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Extraction\Warrant.Extraction.csproj" />
    <ProjectReference Include="..\Warrant.TestSupport\Warrant.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The corpus is compiled in memory from these copies (docs/m4/02). -->
    <None Include="..\corpus\m4\**\*" LinkBase="corpus\m4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\corpus\m5a\**\*" LinkBase="corpus\m5a" CopyToOutputDirectory="PreserveNewest" />
    <!-- The M6 corpus: only extraction and the analyzer read it until M6 U11 (tests/corpus/m6/README.md). -->
    <None Include="..\corpus\m6\**\*" LinkBase="corpus\m6" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Warrant.Vir.Tests\golden\payout.json" Link="golden\payout.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- A Csc argument file and the project files it names (plan M5a U12); its sources are data, not this project's code. -->
    <Compile Remove="cscargs\**" />
    <None Remove="cscargs\**" />
    <None Include="cscargs\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
