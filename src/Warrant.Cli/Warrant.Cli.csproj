<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>warrant</AssemblyName>
    <Description>Command-line tool: check lean4export files with the Warrant kernel, and translate C# to CIC.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Warrant.Lean4Export\Warrant.Lean4Export.csproj" />
    <ProjectReference Include="..\Warrant.Kernel\Warrant.Kernel.csproj" />
    <!-- Warrant.Frontend embeds the Warrant package rather than copying Warrant.dll beside warrant.dll (KTD4). -->
    <ProjectReference Include="..\Warrant.Frontend\Warrant.Frontend.csproj" />
    <ProjectReference Include="..\Warrant.Extraction\Warrant.Extraction.csproj" />
    <ProjectReference Include="..\Warrant.Engine\Warrant.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- `warrant translate` and `warrant verify` load the semantics bundle from beside their own assembly by default. -->
    <None Include="..\..\tests\data\warrant-semantics.ndjson.gz" Link="warrant-semantics.ndjson.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- `warrant verify` loads the attribute sidecar (KTD9) from beside the bundle, and checks it was made for that bundle. -->
    <None Include="..\..\tests\data\warrant-attributes.ndjson.gz" Link="warrant-attributes.ndjson.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Warrant.Cli.Tests" />
  </ItemGroup>
</Project>
