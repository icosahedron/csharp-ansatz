<Project>
  <!--
    Runs `warrant verify` after CoreCompile (docs/m5a/07, KTD21, KTD22). Every build runs the CLI again: the target has no
    Inputs or Outputs, and the result cache (M5b KTD14) is what spares an unchanged build its proof search.
  -->
  <PropertyGroup>
    <WarrantEnabled Condition="'$(WarrantEnabled)' == ''">true</WarrantEnabled>
    <!--
      #32: after its compile, a project records its source (obj/warrant.source), so a project that references it can check
      the [Closed] classes it defines. On even when WarrantEnabled is false, which is how a library that is not verified
      itself shares its closed classes.
    -->
    <WarrantRecordSource Condition="'$(WarrantRecordSource)' == ''">true</WarrantRecordSource>
    <!-- Csc then outputs its full argument list as @(CscCommandLineArgs), which the CLI parses (KTD21). -->
    <ProvideCommandLineArgs Condition="'$(WarrantEnabled)' == 'true' or '$(WarrantRecordSource)' == 'true'">true</ProvideCommandLineArgs>
    <!-- Both paths are overridable so tests can point at a locally built task and CLI. -->
    <WarrantTaskAssembly Condition="'$(WarrantTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Warrant.Build.dll</WarrantTaskAssembly>
    <WarrantCliPath Condition="'$(WarrantCliPath)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\any\warrant.dll</WarrantCliPath>
    <!--
      M5b KTD27: the verification server (off by default in CI, whose agents are thrown away after a job), recheck, and
      the project's result cache. The cache sits under BaseIntermediateOutputPath, which UseArtifactsOutput also defines,
      so every configuration and target framework shares it; every input that matters is in its keys.
    -->
    <WarrantUseServer Condition="'$(WarrantUseServer)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">false</WarrantUseServer>
    <WarrantUseServer Condition="'$(WarrantUseServer)' == ''">true</WarrantUseServer>
    <WarrantRecheck Condition="'$(WarrantRecheck)' == ''">false</WarrantRecheck>
    <!-- WarrantUseCache=false verifies without the result cache; an empty WarrantCacheDir means the default directory. -->
    <WarrantUseCache Condition="'$(WarrantUseCache)' == ''">true</WarrantUseCache>
    <WarrantCacheDir Condition="'$(WarrantCacheDir)' == ''">$(BaseIntermediateOutputPath)warrant/cache/</WarrantCacheDir>
    <_WarrantCacheDirFull>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(WarrantCacheDir)'))</_WarrantCacheDirFull>
    <_WarrantVerifyCacheDir Condition="'$(WarrantUseCache)' == 'true'">$(_WarrantCacheDirFull)</_WarrantVerifyCacheDir>
    <!-- The first entry of $(TargetFrameworks), and whether there are two or more: the inner build that verifies. -->
    <_WarrantFirstTargetFramework>$([System.Text.RegularExpressions.Regex]::Replace('$(TargetFrameworks)', '^[\s;]*([^;\s]*)[\s\S]*$', '$1'))</_WarrantFirstTargetFramework>
    <_WarrantMultiTargeted>$([System.Text.RegularExpressions.Regex]::IsMatch('$(TargetFrameworks)', '[^;\s]\s*;[\s;]*[^;\s]'))</_WarrantMultiTargeted>
  </PropertyGroup>

  <UsingTask TaskName="Warrant.Build.WarrantVerify" AssemblyFile="$(WarrantTaskAssembly)" />

  <Target Name="_WarrantWriteCscArgs"
          Condition="('$(WarrantEnabled)' == 'true' or '$(WarrantRecordSource)' == 'true') and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_WarrantCscArgsFile>$(IntermediateOutputPath)warrant.csc.args</_WarrantCscArgsFile>
    </PropertyGroup>
    <!-- When CoreCompile was up to date Csc did not run and the item is empty: the last compile's file still holds. -->
    <WriteLinesToFile Condition="'@(CscCommandLineArgs)' != ''"
                      File="$(_WarrantCscArgsFile)"
                      Lines="@(CscCommandLineArgs)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_WarrantCscArgsFile)" />
    </ItemGroup>
  </Target>

  <!--
    #32: the source record (Warrant.Frontend.ReferencedSource), $(IntermediateOutputPath)warrant.source: the assembly name,
    the argument file, the project directory, and the SHA-256 of every file the compiler read. A project that references this
    one checks the hashes again before it reads the source, so a file edited after this compile is caught rather than checked
    in place of the compiled one. Written for every target framework, since each inner build is a different reference.

    The inputs are hashed just before CoreCompile and again after it, and the record is written only when Csc ran and both
    hashes agree, so it describes the text Csc read. When they differ (a file saved during the compile) the record is deleted
    and referencing projects fail closed until this project is built again. When CoreCompile was up to date the record from
    the compile that produced the assembly stands.
  -->
  <Target Name="_WarrantHashSourcesBeforeCompile"
          BeforeTargets="CoreCompile"
          Condition="'$(WarrantRecordSource)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <GetFileHash Files="@(Compile);@(AdditionalFiles);@(EditorConfigFiles)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WarrantSourceHashBefore" />
    </GetFileHash>
  </Target>

  <Target Name="WarrantRecordSource"
          AfterTargets="CoreCompile"
          DependsOnTargets="_WarrantWriteCscArgs"
          Condition="'$(WarrantRecordSource)' == 'true' and '$(DesignTimeBuild)' != 'true' and '@(CscCommandLineArgs)' != ''">
    <PropertyGroup>
      <_WarrantCscArgsFileFull>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_WarrantCscArgsFile)'))</_WarrantCscArgsFileFull>
      <_WarrantSourceRecordFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'warrant.source'))</_WarrantSourceRecordFile>
    </PropertyGroup>
    <GetFileHash Files="@(Compile);@(AdditionalFiles);@(EditorConfigFiles)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WarrantSourceHashAfter" />
    </GetFileHash>
    <GetFileHash Files="$(_WarrantCscArgsFileFull)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WarrantArgsHash" />
    </GetFileHash>
    <!--
      Compare the files hashed both times. The SDK adds some inputs after the first hash (its analysis-level global
      config); those come from the SDK, not from edits, and are hashed into the record from the second hash only. Every
      file in the second hash with no identical first-hash line is either late or changed, so the counts must agree.
    -->
    <ItemGroup>
      <_WarrantBeforeLine Include="@(_WarrantSourceHashBefore->'%(FullPath)|%(FileHash)')" />
      <_WarrantAfterLine Include="@(_WarrantSourceHashAfter->'%(FullPath)|%(FileHash)')" />
      <_WarrantBeforePath Include="@(_WarrantSourceHashBefore->'%(FullPath)')" />
      <_WarrantLatePath Include="@(_WarrantSourceHashAfter->'%(FullPath)')" Exclude="@(_WarrantBeforePath)" />
      <_WarrantDifferentLine Include="@(_WarrantAfterLine)" Exclude="@(_WarrantBeforeLine)" />
    </ItemGroup>
    <PropertyGroup>
      <_WarrantSourceUnchanged>false</_WarrantSourceUnchanged>
      <_WarrantSourceUnchanged Condition="'@(_WarrantDifferentLine->Count())' == '@(_WarrantLatePath->Count())'">true</_WarrantSourceUnchanged>
    </PropertyGroup>
    <ItemGroup>
      <_WarrantSourceLine Include="warrant-source 1" />
      <_WarrantSourceLine Include="assembly=$(TargetName)" />
      <_WarrantSourceLine Include="args=$(_WarrantCscArgsFileFull)" />
      <_WarrantSourceLine Include="project=$(MSBuildProjectDirectory)" />
      <_WarrantSourceLine Include="@(_WarrantArgsHash->'file=%(FileHash)|%(FullPath)')" />
      <_WarrantSourceLine Include="@(_WarrantSourceHashAfter->'file=%(FileHash)|%(FullPath)')" />
    </ItemGroup>
    <WriteLinesToFile Condition="'$(_WarrantSourceUnchanged)' == 'true'"
                      File="$(_WarrantSourceRecordFile)"
                      Lines="@(_WarrantSourceLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <Delete Condition="'$(_WarrantSourceUnchanged)' != 'true'" Files="$(_WarrantSourceRecordFile)" />
    <Message Condition="'$(_WarrantSourceUnchanged)' != 'true'" Importance="high"
             Text="Warrant: a source file changed while $(TargetName) compiled, so it has no source record; build it again before verifying a project that uses its [Closed] classes." />
    <ItemGroup>
      <FileWrites Include="$(_WarrantSourceRecordFile)" />
    </ItemGroup>
  </Target>

  <!-- #32: what Build and GetTargetPath return for this project names its source record, so referencing projects find it. -->
  <Target Name="_WarrantSourceRecordMetadata"
          AfterTargets="GetTargetPathWithTargetPlatformMoniker"
          Condition="'$(WarrantRecordSource)' == 'true'">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker>
        <WarrantSourceRecord>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'warrant.source'))</WarrantSourceRecord>
      </TargetPathWithTargetPlatformMoniker>
    </ItemGroup>
  </Target>

  <Target Name="WarrantVerify"
          AfterTargets="CoreCompile"
          DependsOnTargets="_WarrantWriteCscArgs;WarrantRecordSource"
          Condition="'$(WarrantEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' == '$(_WarrantFirstTargetFramework)')">
    <ItemGroup>
      <!-- The referenced projects' source records, which reach ReferencePath with the rest of their outputs' metadata. -->
      <_WarrantReferenceSource Include="@(ReferencePath->'%(WarrantSourceRecord)'->Distinct())" />
    </ItemGroup>
    <WarrantVerify CscArgsFile="$(_WarrantCscArgsFile)"
                   ProjectDirectory="$(MSBuildProjectDirectory)"
                   ReferenceSources="@(_WarrantReferenceSource)"
                   CliPath="$(WarrantCliPath)"
                   DotnetHostPath="$(DOTNET_HOST_PATH)"
                   KernelFuel="$(WarrantKernelFuel)"
                   TacticFuel="$(WarrantTacticFuel)"
                   TimeoutSeconds="$(WarrantTimeoutSeconds)"
                   KeepConditionalCheck="$(_WarrantMultiTargeted)"
                   UseServer="$(WarrantUseServer)"
                   Recheck="$(WarrantRecheck)"
                   CacheDirectory="$(_WarrantVerifyCacheDir)" />
  </Target>

  <!--
    dotnet clean and Rebuild delete the project's result cache (M5b R12, KTD27), and nothing else: only a directory the
    cache marked as its own (ResultCache.MarkerFileName), only the files the cache writes there (entries named by their
    64-hex-digit key, their temporary files, the marker), and the directory itself only when that leaves it empty. A
    WarrantCacheDir that names a source or home directory by mistake therefore loses nothing.
  -->
  <Target Name="WarrantClean" AfterTargets="Clean" Condition="Exists('$(_WarrantCacheDirFull)WARRANT-CACHE')">
    <ItemGroup>
      <_WarrantCacheCandidate Include="$(_WarrantCacheDirFull)*.json;$(_WarrantCacheDirFull)*.tmp" />
      <_WarrantCacheFile Include="@(_WarrantCacheCandidate)"
                         Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_WarrantCacheCandidate.Filename)%(_WarrantCacheCandidate.Extension)', '^[0-9a-f]{64}\.json(\.[0-9a-f]{32}\.tmp)?$'))" />
      <_WarrantCacheFile Include="$(_WarrantCacheDirFull)WARRANT-CACHE" />
    </ItemGroup>
    <Delete Files="@(_WarrantCacheFile)" />
    <ItemGroup>
      <_WarrantCacheLeft Include="$(_WarrantCacheDirFull)**" />
    </ItemGroup>
    <RemoveDir Directories="$(_WarrantCacheDirFull)" Condition="'@(_WarrantCacheLeft)' == ''" />
  </Target>
</Project>
