<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!--
      Never the Warrant package itself: its Warrant.dll would land beside the CLI's warrant.dll, and on Windows the two
      names are one file (KTD4). The CLI's reference brings the semantics bundle along as content.
    -->
    <ProjectReference Include="..\..\src\Warrant.Cli\Warrant.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\corpus\m4\**\*" LinkBase="corpus\m4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
