<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" Version="3.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Warrant.TestSupport" />
    <ProjectReference Include="..\..\src\Warrant.Kernel\Warrant.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Lean4Export\Warrant.Lean4Export.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Semantics\Warrant.Semantics.csproj" />
    <ProjectReference Include="..\Warrant.TestSupport\Warrant.TestSupport.csproj" />
    <!-- Test-only: the corpus is compiled and extracted here; Warrant.Semantics itself never sees Roslyn (KTD3). -->
    <ProjectReference Include="..\..\src\Warrant\Warrant.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Frontend\Warrant.Frontend.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Extraction\Warrant.Extraction.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\data\warrant-semantics.ndjson.gz" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\lean\bundle-roots.txt" Link="data\bundle-roots.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The corpus is compiled in memory from these copies (docs/m4/02). -->
    <None Include="..\corpus\m4\**\*" LinkBase="corpus\m4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\corpus\m5a\**\*" LinkBase="corpus\m5a" CopyToOutputDirectory="PreserveNewest" />
    <!-- Read only by MonadicTranslationTests, which translates the M6 members M6 U9 can (no decimal, contract or dependency). -->
    <None Include="..\corpus\m6\**\*" LinkBase="corpus\m6" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
