<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!--
      Never the Warrant package itself: its Warrant.dll would land beside the CLI's warrant.dll, and on Windows the two
      names are one file (KTD4). The CLI's reference brings the semantics bundle along as content.
    -->
    <ProjectReference Include="..\..\src\Warrant.Cli\Warrant.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\corpus\m4\**\*" LinkBase="corpus\m4" CopyToOutputDirectory="PreserveNewest" />
    <!-- The M5a exit corpus, which the parity test verifies through the server and in-process (M5b KTD28). -->
    <None Include="..\corpus\m5a\**\*" LinkBase="corpus\m5a" CopyToOutputDirectory="PreserveNewest" />
    <!-- The M6 corpus's members without dependencies (plan M6 U11); the files with dependencies come with U19 and U20. -->
    <None Include="..\corpus\m6\**\*" Exclude="..\corpus\m6\accepted\Payments.cs;..\corpus\m6\accepted\Dependencies.cs;..\corpus\m6\rejected\Dependencies.cs" LinkBase="corpus\m6" CopyToOutputDirectory="PreserveNewest" />
    <!-- A Csc argument file and the project files it names (plan M5a U12); its sources are data, not this project's code. -->
    <Compile Remove="cscargs\**" />
    <None Remove="cscargs\**" />
    <None Include="cscargs\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Linked, not referenced: Warrant.TestSupport brings the Warrant package's Warrant.dll (KTD4). -->
    <Compile Include="..\Warrant.TestSupport\SourceGeneratorAssemblies.cs" Link="SourceGeneratorAssemblies.cs" />
    <Compile Include="..\Warrant.TestSupport\FactRequiringEnvAttribute.cs" Link="FactRequiringEnvAttribute.cs" />
  </ItemGroup>
</Project>
