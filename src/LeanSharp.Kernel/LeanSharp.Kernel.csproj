  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LeanSharp.Cic\LeanSharp.Cic.csproj" />
    <InternalsVisibleTo Include="LeanSharp.Kernel.Tests" />
  </ItemGroup>
</Project>
