<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Warrant.TestSupport" />
    <ProjectReference Include="..\..\src\Warrant.Engine\Warrant.Engine.csproj" />
    <ProjectReference Include="..\Warrant.TestSupport\Warrant.TestSupport.csproj" />
    <!-- Test-only: the corpus is compiled and extracted here; Warrant.Engine itself never sees Roslyn (KTD3). -->
    <ProjectReference Include="..\..\src\Warrant\Warrant.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Frontend\Warrant.Frontend.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Extraction\Warrant.Extraction.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\data\warrant-semantics.ndjson.gz" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\warrant-attributes.ndjson.gz" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\lean\bundle-roots.txt" Link="data\bundle-roots.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The corpora are compiled in memory from these copies (docs/m4/02, docs/m5a/01). -->
    <None Include="..\corpus\m4\**\*" LinkBase="corpus\m4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\corpus\m5a\**\*" LinkBase="corpus\m5a" CopyToOutputDirectory="PreserveNewest" />
    <!-- Read only by the differential tests until plan M6 U11 adds the engine's M6 corpus runs (Differential/README.md). -->
    <None Include="..\corpus\m6\**\*" LinkBase="corpus\m6" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
