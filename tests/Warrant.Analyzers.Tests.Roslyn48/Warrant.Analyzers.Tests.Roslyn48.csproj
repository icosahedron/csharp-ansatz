<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The same analyzer tests under Roslyn 4.8, the compiler the .NET 8 SDK and Visual Studio 2022 load (M5b KTD21): the
    analyzer must load and report there too. The tests are linked from Warrant.Analyzers.Tests; the corpus parity test
    is not, because the corpus uses C# 14 and the frontend that compiles it needs Roslyn 5.9.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);ROSLYN48</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Warrant\Warrant.csproj" />
    <ProjectReference Include="..\..\src\Warrant.Analyzers\Warrant.Analyzers.csproj" Aliases="analyzers" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Warrant.Analyzers.Tests\AnalyzerHarness.cs" Link="AnalyzerHarness.cs" />
    <Compile Include="..\Warrant.Analyzers.Tests\AnalyzerTests.cs" Link="AnalyzerTests.cs" />
    <Compile Include="..\Warrant.Analyzers.Tests\ContractSurfaceTests.cs" Link="ContractSurfaceTests.cs" />
  </ItemGroup>
</Project>
