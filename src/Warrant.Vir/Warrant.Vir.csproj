<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The verification IR between extraction and translation: the typed model, its canonical encoding, and its unit and closure hashes.</Description>
    <!-- Directory.Build.props sets TargetFramework; this project multi-targets instead (KTD3). -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <!-- CA1720: Int32, Int64 and Int name VIR's own types (docs/m4/04), as the encoding spells them. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- The reader is for the engine and the server only (docs/m4/04). -->
    <Compile Remove="VirReader.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <Compile Remove="IsExternalInit.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Warrant.Vir.Tests" />
  </ItemGroup>
  <!--
    The analyzer compiles these sources into the compiler (M5b KTD21): Roslyn's rules for analyzer code (RS1035: no file,
    console or process I/O) and a ban on clocks, randomness, GUIDs and Environment, so nothing nondeterministic creeps in.
  -->
  <PropertyGroup>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="..\BannedSymbols.Analyzer.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- RS1035 comes with the analyzers Roslyn's packages bring; Vir references no Roslyn of its own. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>
</Project>
