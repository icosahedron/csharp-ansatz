<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Untrusted orchestration after extraction (KTD3, KTD22): admits translated VIR units into a fork of the semantics bundle, emits rfl and decide proofs, runs proof scripts through Warrant.Meta, classifies outcomes, reads values back and writes NDJSON.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Never Roslyn (KTD3): the engine sees only VIR. -->
    <ProjectReference Include="..\Warrant.Vir\Warrant.Vir.csproj" />
    <ProjectReference Include="..\Warrant.Cic\Warrant.Cic.csproj" />
    <ProjectReference Include="..\Warrant.Kernel\Warrant.Kernel.csproj" />
    <ProjectReference Include="..\Warrant.Lean4Export\Warrant.Lean4Export.csproj" />
    <ProjectReference Include="..\Warrant.Semantics\Warrant.Semantics.csproj" />
    <ProjectReference Include="..\Warrant.Meta\Warrant.Meta.csproj" />
    <InternalsVisibleTo Include="Warrant.Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lean 4.35.0's declarations that fix what the standard axioms and the kernel's name-reduced constants mean, made
         from the committed bundle by scripts/pin-kernel-declarations.cs (#26). -->
    <EmbeddedResource Include="PinnedDeclarations.ndjson.gz" LogicalName="Warrant.Engine.PinnedDeclarations.ndjson.gz" />
  </ItemGroup>
</Project>
