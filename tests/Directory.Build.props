<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Inline expected arrays are clearer than hoisted static fields in tests. -->
    <NoWarn>$(NoWarn);CA1861;CA1859</NoWarn>
  </PropertyGroup>
</Project>
